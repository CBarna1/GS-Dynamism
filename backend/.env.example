# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=guidingstars_user
DB_PASSWORD=your_strong_db_password_here
DB_NAME=guiding_stars

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_hex_string_here

# ─── URLs ─────────────────────────────────────────────────────────────────────
SITE_URL=https://www.guidingstarszm.com
FRONTEND_URL=https://www.guidingstarszm.com

# ─── Email (Zoho Mail SMTP) ───────────────────────────────────────────────────
# Use your full Zoho email address as the username
# If you have 2FA enabled on Zoho, generate an App Password:
#   Zoho Account → Security → App Passwords → Add
EMAIL_USER=admissions@guidingstarszm.com
EMAIL_PASSWORD=your_zoho_account_password_here
