# .env Example for SEO Configuration
# Copy these to your actual .env file and update with your values

# === BACKEND SEO ===
# Set this to your production URL for proper sitemap generation
SITE_URL=https://guidingstars.com

# === FRONTEND (Optional) ===
# Base URL for React app (used in SEO config)
REACT_APP_BASE_URL=https://guidingstars.com

# === Development ===
# Use localhost for local development
# SITE_URL=http://localhost:5000
# REACT_APP_BASE_URL=http://localhost:5173

# Note: Make sure to update these values when deploying to production!
